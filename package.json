{
  "name": "wdio-typescript-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "WebdriverIO 9 + TypeScript E2E suite covering the interaction patterns that actually break: iframes, alerts, dynamic rendering, file transfer, basic auth and shadow DOM",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "wdio run ./config/wdio.conf.ts",
    "test:smoke": "wdio run ./config/wdio.conf.ts --suite smoke",
    "test:frames": "wdio run ./config/wdio.conf.ts --suite frames",
    "test:dynamic": "wdio run ./config/wdio.conf.ts --suite dynamic",
    "test:files": "wdio run ./config/wdio.conf.ts --suite files",
    "test:headed": "HEADED=1 wdio run ./config/wdio.conf.ts",
    "typecheck": "tsc --noEmit",
    "report": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^20.11.0",
    "@wdio/allure-reporter": "^9.4.1",
    "@wdio/cli": "^9.4.1",
    "@wdio/globals": "^9.4.1",
    "@wdio/local-runner": "^9.4.1",
    "@wdio/mocha-framework": "^9.4.1",
    "@wdio/spec-reporter": "^9.4.1",
    "@wdio/types": "^9.4.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-wdio": "^9.31.3",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2"
  }
}
